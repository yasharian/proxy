# HTTP — redirect to HTTPS
server {
    listen 80;
    server_name pv.yasharian.ir;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — main server
server {
    listen 443 ssl http2;
    server_name pv.yasharian.ir;

    ssl_certificate /etc/letsencrypt/live/pv.yasharian.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pv.yasharian.ir/privkey.pem;

    # SSL security
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # VPN — only when correct host header
    # /api path
    location /api {
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # /v1/api path (tapsi-style)
    location /v1/api {
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # /graphql path (tapsi-style)
    location /graphql {
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Tapsi homepage
    location = / {
        root /var/www/html;
        try_files /tapsi.html =404;
    }

    # Tapsi pages
    location /driver {
        root /var/www/html/pages;
        try_files /driver.html =404;
    }

    location /contact {
        root /var/www/html/pages;
        try_files /contact.html =404;
    }

    location /faq {
        root /var/www/html/pages;
        try_files /faq.html =404;
    }

    location /app {
        root /var/www/html;
        try_files /tapsi-app.html =404;
    }

    # Static assets
    location /assets {
        root /var/www/html;
    }

    location /static {
        root /var/www/html;
    }

    # Default fallback
    location / {
        root /var/www/html;
        try_files /tapsi.html =404;
    }
}

# Fallback for direct IP
server {
    listen 80 default_server;
    listen 443 ssl default_server;

    ssl_certificate /etc/letsencrypt/live/pv.yasharian.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pv.yasharian.ir/privkey.pem;

    location / {
        root /var/www/html;
        try_files /tapsi.html =404;
    }
}